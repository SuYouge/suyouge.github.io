{
  "name": "low-tech-land",
  "version": "1.0.0",
  "private": true,
  "description": "Su Youge's lightweight Eleventy blog",
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean.js",
    "predev": "npm run clean",
    "dev": "eleventy --serve",
    "prebuild": "npm run clean",
    "build": "eleventy",
    "precheck": "npm run build",
    "check": "node scripts/check-build.js",
    "debug": "DEBUG=Eleventy* eleventy"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-plugin-rss": "^3.0.0",
    "@excalidraw/utils": "^0.1.3-test32",
    "@mdit/plugin-footnote": "^1.1.0",
    "@mdit/plugin-katex": "^1.1.0",
    "jsdom": "^28.1.0",
    "katex": "^0.16.22",
    "markdown-it": "^15.0.0",
    "markdown-it-anchor": "^9.2.0"
  }
}
