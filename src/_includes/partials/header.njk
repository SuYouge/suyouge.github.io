<header class="site-header">
  <div class="nav-shell container-wide">
    <a class="wordmark" href="/" aria-label="{{ site.name }} 首页">
      <span class="wordmark-mark" aria-hidden="true">L</span>
      <span>{{ site.name }}</span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="sr-only">打开导航</span>
      <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
    </button>
    <nav id="site-nav" class="site-nav" aria-label="主导航">
      <a href="/"{% if page.url == '/' %} aria-current="page"{% endif %}>首页</a>
      <a href="/blog/"{% if '/blog/' in page.url %} aria-current="page"{% endif %}>博客</a>
      <a href="/tags/"{% if '/tags/' in page.url %} aria-current="page"{% endif %}>标签</a>
      <a href="/about/"{% if page.url == '/about/' %} aria-current="page"{% endif %}>关于</a>
      <button class="theme-toggle" type="button" aria-label="切换明暗主题" title="切换明暗主题">
        <span class="theme-icon" aria-hidden="true">◐</span>
      </button>
    </nav>
  </div>
</header>
